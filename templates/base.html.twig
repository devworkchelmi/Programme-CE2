<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Carnet CE2{% endblock %}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap">
    {# Palette et typographies reprises du canevas de design validé (cf. 01-parcours-produit-maquettes) #}
    <style>
        :root {
            --bg: oklch(97% 0.015 75);
            --surface: oklch(99% 0.004 75);
            --ink: oklch(27% 0.02 75);
            --ink-soft: oklch(48% 0.02 75);
            --border: oklch(90% 0.012 75);
            --accent: oklch(70% 0.18 45);
            --accent-soft: oklch(94% 0.035 45);
            --success: oklch(60% 0.13 148);
            --amber: oklch(76% 0.13 75);
            --adult: oklch(46% 0.07 250);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Atkinson Hyperlegible', sans-serif;
            background: var(--bg);
            color: var(--ink);
        }
        h1, h2, h3 { font-family: 'Baloo 2', sans-serif; }
        a { color: var(--accent); }
        .header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 32px; border-bottom: 1px solid var(--border);
        }
        .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; }
        .logo-badge {
            width: 34px; height: 34px; border-radius: 9px; background: var(--accent);
            color: white; display: flex; align-items: center; justify-content: center; font-family: 'Baloo 2';
        }
        .container { max-width: 820px; margin: 0 auto; padding: 24px 32px; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 22px; }
        .btn {
            display: inline-block; background: var(--accent); color: white; text-align: center;
            padding: 14px 22px; border-radius: 12px; font-family: 'Baloo 2'; font-weight: 700;
            text-decoration: none; border: none; cursor: pointer; font-size: 15px;
        }
        .btn-outline { background: transparent; color: var(--ink); border: 1.5px solid var(--border); }
        .flash { padding: 12px 16px; border-radius: 10px; margin-bottom: 16px; font-size: 14px; }
        .flash-success { background: oklch(95% 0.03 148); border: 1px solid var(--success); }
        .flash-info { background: var(--accent-soft); border: 1px solid var(--accent); }

        .header { flex-wrap: wrap; gap: 12px; position: sticky; top: 0; background: var(--surface); z-index: 10; }
        .navbar { display: flex; gap: 4px; align-items: center; font-size: 14px; flex: 1; }
        .nav-link {
            padding: 8px 14px; border-radius: 10px; text-decoration: none; color: var(--ink-soft);
            font-family: 'Baloo 2', sans-serif; font-weight: 600; transition: background .15s, color .15s;
        }
        .nav-link:hover { background: var(--accent-soft); color: var(--ink); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .navbar-user { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--ink-soft); }
        .btn-sm { padding: 8px 16px; font-size: 13px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="header">
    <a href="{{ app.user ? path('adulte_suivi') : path('app_login') }}" class="logo" style="text-decoration:none; color:inherit;">
        <span class="logo-badge">C</span> Carnet CE2
    </a>

    {% if app.user %}
        {% set route = app.request.attributes.get('_route') %}
        <nav class="navbar">
            <a href="{{ path('adulte_suivi') }}" class="nav-link {{ route starts with 'adulte_suivi' ? 'active' : '' }}">Suivi</a>
            {# D'autres liens (historique des relectures, réglages...) viendront ici au fil des écrans #}
        </nav>

        <div class="navbar-user">
            <span>{{ app.user.email }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline btn-sm">Déconnexion</a>
        </div>
    {% endif %}
</div>

<div class="container">
    {% if llm_mode_demo %}
        <div class="flash" style="background: oklch(95% 0.05 75); border:1px solid var(--amber); display:flex; gap:8px; align-items:center;">
            <strong>Mode démo</strong> — les textes, analyses et feedbacks sont fabriqués localement, sans appel à l'API Claude.
        </div>
    {% endif %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
