<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Carnet CE2{% endblock %}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap">
    {# Palette et typographies reprises du canevas de design validé (cf. 01-parcours-produit-maquettes) #}
    <style>
        :root {
            /* Fond enfant en rose pâle (remplace l'ancien fond chaud beige/pêche) — le
               bleu de l'accent (--accent-gradient plus haut... voir plus bas) ressort
               bien sur ce rose. Reste un ton clair et doux, pas criard. Le texte
               (--ink/--ink-soft) passe du gris-brun neutre d'origine à une encre
               prune/mauve — même famille pastel que le rose du fond et le bleu de
               l'accent (mauve = à mi-chemin sur le cercle chromatique entre les deux),
               tout en restant assez sombre pour un excellent contraste de lecture. */
            --bg: oklch(96% 0.02 10);
            --surface: oklch(99% 0.008 10);
            --ink: oklch(30% 0.055 320);
            --ink-soft: oklch(50% 0.045 320);
            --border: oklch(90% 0.015 10);
            /* Dégradé « ciel/nuit » — remplace l'orange d'origine côté enfant (cf. écrans
               Diagnostic/Exercice/Feedback). --accent reste une couleur pleine pour le
               texte, les bordures et les icônes (un dégradé n'y est pas utilisable) ;
               --accent-gradient habille les surfaces pleines (boutons, badge du logo). */
            --accent: oklch(54% 0.17 255);
            --accent-soft: oklch(94% 0.04 222);
            --accent-gradient: linear-gradient(135deg, oklch(62% 0.15 218) 0%, oklch(30% 0.15 270) 100%);
            --success: oklch(60% 0.13 148);
            --amber: oklch(76% 0.13 75);
            --adult: oklch(46% 0.07 250);
            --adult-soft: oklch(94% 0.02 250);
        }
        /* Espace adulte (Suivi, Relecture) : fond bleu-gris plutôt que le fond chaud
           partagé par les écrans enfant — distingue visuellement les deux univers, comme
           dans le canevas de design (cf. 01-parcours-produit-maquettes, SuiviAdulte/Relecture).
           L'accent adulte reprend maintenant la même famille bleue que le dégradé enfant
           (cf. --accent-gradient dans :root), mais nettement plus sobre et sombre — même
           logique « ciel/nuit », desaturée pour rester pro — afin que les deux univers
           restent distincts par l'intensité plutôt que par la teinte. Proche de --adult,
           déjà utilisé pour la sparkline de tendance sur le suivi. */
        body.theme-adulte {
            --bg: oklch(96% 0.008 250);
            --surface: oklch(99% 0.003 250);
            --ink: oklch(24% 0.015 250);
            --ink-soft: oklch(46% 0.015 250);
            --border: oklch(89% 0.012 250);
            --accent: oklch(40% 0.075 255);
            --accent-soft: oklch(93% 0.02 240);
            --accent-gradient: linear-gradient(135deg, oklch(46% 0.07 250) 0%, oklch(24% 0.08 268) 100%);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Atkinson Hyperlegible', sans-serif;
            background: var(--bg);
            color: var(--ink);
        }
        h1, h2, h3 { font-family: 'Baloo 2', sans-serif; }
        a { color: var(--accent); }
        .header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 32px; border-bottom: 1px solid var(--border);
        }
        .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; }
        .logo-badge {
            width: 34px; height: 34px; border-radius: 9px; background: var(--accent-gradient);
            color: white; display: flex; align-items: center; justify-content: center; font-family: 'Baloo 2';
        }
        .container { max-width: 820px; margin: 0 auto; padding: 24px 32px; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 22px; }
        .btn {
            display: inline-block; background: var(--accent-gradient); color: white; text-align: center;
            padding: 14px 22px; border-radius: 12px; font-family: 'Baloo 2'; font-weight: 700;
            text-decoration: none; border: none; cursor: pointer; font-size: 15px;
        }
        .btn-outline { background: transparent; color: var(--ink); border: 1.5px solid var(--border); }
        .btn:disabled { opacity: .45; cursor: not-allowed; }
        .flash { padding: 12px 16px; border-radius: 10px; margin-bottom: 16px; font-size: 14px; }
        .flash-success { background: oklch(95% 0.03 148); border: 1px solid var(--success); }
        .flash-info { background: var(--accent-soft); border: 1px solid var(--accent); }

        .header { flex-wrap: wrap; gap: 12px; position: sticky; top: 0; background: var(--surface); z-index: 10; }
        .navbar { display: flex; gap: 4px; align-items: center; font-size: 14px; flex: 1; }
        .nav-link {
            padding: 8px 14px; border-radius: 10px; text-decoration: none; color: var(--ink-soft);
            font-family: 'Baloo 2', sans-serif; font-weight: 600; transition: background .15s, color .15s;
        }
        .nav-link:hover { background: var(--accent-soft); color: var(--ink); }
        .nav-link.active { background: var(--accent-soft); color: var(--accent); }
        .navbar-user { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--ink-soft); }
        .btn-sm { padding: 8px 16px; font-size: 13px; }
    </style>
    {% block stylesheets %}{% endblock %}
    {# AssetMapper (remplace Webpack Encore) : sert assets/app.js (+ tout CSS qu'il
       importerait) directement, sans build ni npm. Voir importmap.php. #}
    {{ importmap('app') }}
</head>
{% set route = app.request.attributes.get('_route') %}
<body class="{{ route starts with 'adulte' ? 'theme-adulte' : '' }}">
<div class="header">
    <a href="{{ app.user ? path('adulte_suivi') : path('app_login') }}" class="logo" style="text-decoration:none; color:inherit;">
        <span class="logo-badge">C</span> Carnet CE2
    </a>

    {% if app.user %}
        <nav class="navbar">
            <a href="{{ path('adulte_suivi') }}" class="nav-link {{ route starts with 'adulte_suivi' ? 'active' : '' }}">Suivi</a>
            {# D'autres liens (historique des relectures, réglages...) viendront ici au fil des écrans #}
        </nav>

        <div class="navbar-user">
            <span>{{ app.user.email }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline btn-sm">Déconnexion</a>
        </div>
    {% endif %}
</div>

<div class="container">
    {% if llm_mode_demo %}
        <div class="flash" style="background: oklch(95% 0.05 75); border:1px solid var(--amber); display:flex; gap:8px; align-items:center;">
            <strong>Mode démo</strong> — les textes, analyses et feedbacks sont fabriqués localement, sans appel à l'API Claude.
        </div>
    {% endif %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

{% block javascripts %}{% endblock %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
</body>
</html>
