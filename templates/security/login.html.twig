{% extends 'base.html.twig' %}

{% block title %}Connexion — Carnet CE2{% endblock %}

{% block body %}
    <div class="card" style="max-width:380px; margin: 40px auto;">
        <h1 style="font-size:22px; margin-top:0;">Connexion</h1>

        {% if error %}
            <div class="flash" style="background: var(--amber); border:1px solid var(--amber);">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" style="display:flex; flex-direction:column; gap:12px;">
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" required autofocus
                   style="padding:10px; border-radius:8px; border:1px solid var(--border);">

            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" required
                   style="padding:10px; border-radius:8px; border:1px solid var(--border);">

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <label style="display:flex; align-items:center; gap:8px; font-weight:normal;">
                <input type="checkbox" name="_remember_me" id="remember_me">
                Se souvenir de moi
            </label>

            <button class="btn" type="submit" style="margin-top:8px;">Se connecter</button>
        </form>
    </div>
{% endblock %}
