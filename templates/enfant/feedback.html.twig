{% extends 'base.html.twig' %}

{% block title %}Feedback — Carnet CE2{% endblock %}

{% block body %}
    <div style="display:flex; flex-direction:column; gap:20px;">
        {% if session.type.value == 'diagnostic' and enfant is defined and enfant and enfant.diagnosticTermine %}
            <div class="card" style="border-color: var(--success); background: oklch(95% 0.03 148); text-align:center;">
                <div style="font-family:'Baloo 2'; font-size:20px; margin-bottom:6px;">🎉 Diagnostic terminé&nbsp;!</div>
                <p style="margin:0;">Merci d'avoir répondu à tous les textes. On sait maintenant où commencer&nbsp;!</p>
            </div>
        {% elseif session.type.value == 'diagnostic' %}
            <div class="card" style="border-style:dashed; text-align:center;">
                <p style="margin:0;">Bien joué&nbsp;! Il reste encore un ou deux textes de diagnostic — demande à un adulte de continuer bientôt.</p>
            </div>
        {% endif %}

        <div>
            <h1 style="font-size:23px; margin:0;">Bien joué pour cet exercice&nbsp;!</h1>
            <p style="font-size:14.5px; color:var(--ink-soft); margin:4px 0 0;">Voici ce que le correcteur a noté pour toi.</p>
        </div>

        {% for question in texte.questions %}
            {% set reponse = question.reponse %}
            {% set estCorrecte = reponse and reponse.correcte.value == 'oui' %}
            <div class="card" style="border-width:1.5px; border-color: {{ estCorrecte ? 'var(--success)' : 'var(--amber)' }}; background: {{ estCorrecte ? 'oklch(95% 0.03 148)' : 'oklch(95% 0.03 75)' }};">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                    <div style="width:26px; height:26px; border-radius:50%; background:{{ estCorrecte ? 'var(--success)' : 'var(--amber)' }}; display:flex; align-items:center; justify-content:center; flex:none;">
                        {% if estCorrecte %}
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
                        {% else %}
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="white" stroke-width="2.6" stroke-linecap="round"><line x1="12" y1="8" x2="12" y2="13"></line><circle cx="12" cy="16.5" r="0.9" fill="white" stroke="none"></circle></svg>
                        {% endif %}
                    </div>
                    <div style="font-weight:700; font-size:15.5px;">
                        Question {{ loop.index }} — {{ estCorrecte ? 'C\'est ça !' : 'Presque !' }}
                    </div>
                </div>
                {% if reponse and reponse.contenuEnfant|trim is not empty %}
                    <p style="margin:0 0 8px; font-size:13.5px; color:var(--ink-soft);">
                        Ta réponse : « {{ reponse.contenuEnfant }} »
                    </p>
                {% endif %}
                {% if reponse and reponse.feedback %}
                    <p style="margin:0;">{{ reponse.feedback.texteFeedback }}</p>
                {% elseif estCorrecte %}
                    <p style="margin:0;">Bravo, c'est exactement ça !</p>
                {% endif %}

                {# Orthographe : 2 mots au maximum et toujours après le feedback de
                   compréhension — c'est un bonus, pas le sujet principal (§2.3). #}
                {% if reponse and reponse.correctionsOrthographe is not empty %}
                    <p style="margin:10px 0 0; padding-top:10px; border-top:1px dashed var(--border); font-size:14px;">
                        Au fait, on écrit&nbsp;:
                        {% for correction in reponse.correctionsOrthographe|slice(0, 2) %}
                            <strong>{{ correction.correction }}</strong>
                            <span style="color:var(--ink-soft);">(tu as écrit «&nbsp;{{ correction.mot_ecrit }}&nbsp;»)</span>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>
                {% endif %}
            </div>
        {% endfor %}

        <div class="card" style="border-style:dashed; font-size:13px; color:var(--ink-soft);">
            Le niveau de ton prochain exercice s'ajuste automatiquement grâce à tes réponses.
        </div>

        <a href="{{ path('adulte_suivi') }}" class="btn">Terminer</a>
    </div>
{% endblock %}
