{% extends 'base.html.twig' %}

{% block title %}Feedback — Carnet CE2{% endblock %}

{% block body %}
    <div style="display:flex; flex-direction:column; gap:20px;">
        <h1 style="font-size:23px; margin:0;">Bien joué pour cet exercice&nbsp;!</h1>

        {% for question in texte.questions %}
            {% set reponse = question.reponse %}
            {% set estCorrecte = reponse and reponse.correcte.value == 'oui' %}
            <div class="card" style="border-color: {{ estCorrecte ? 'var(--success)' : 'var(--amber)' }}; background: {{ estCorrecte ? 'oklch(95% 0.03 148)' : 'oklch(95% 0.03 75)' }};">
                <div style="font-weight:700; margin-bottom:8px;">
                    Question {{ loop.index }} — {{ estCorrecte ? 'C\'est ça !' : 'Presque !' }}
                </div>
                {% if reponse and reponse.feedback %}
                    <p style="margin:0;">{{ reponse.feedback.texteFeedback }}</p>
                {% elseif estCorrecte %}
                    <p style="margin:0;">Bravo, c'est exactement ça !</p>
                {% endif %}
            </div>
        {% endfor %}

        <div class="card" style="border-style:dashed; font-size:13px; color:var(--ink-soft);">
            Le niveau de ton prochain exercice s'ajuste automatiquement grâce à tes réponses.
        </div>

        <a href="{{ path('adulte_suivi') }}" class="btn">Terminer</a>
    </div>
{% endblock %}
