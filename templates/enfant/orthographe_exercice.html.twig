{% extends 'base.html.twig' %}

{% block title %}Exercice d'orthographe — Carnet CE2{% endblock %}

{% block body %}
    <style>
        /* Boutons de choix de mot (même logique visuelle que les options QCM de la
           compréhension, cf. enfant/_questions.html.twig) : cercle qui se remplit,
           bordure et fond accentués quand une proposition est sélectionnée. */
        .mot-choix {
            display: flex; align-items: center; gap: 12px; padding: 13px 16px;
            border: 1.5px solid var(--border); border-radius: 12px; background: var(--surface);
            cursor: pointer; transition: border-color .12s, background-color .12s, padding .12s;
        }
        .mot-choix:has(.mot-radio:checked) {
            border: 2px solid var(--accent); background: var(--accent-soft); padding: 12px 15px;
        }
        .mot-cercle {
            width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--border);
            flex: none; display: flex; align-items: center; justify-content: center;
        }
        .mot-radio:checked ~ .mot-cercle { border-color: var(--accent); }
        .mot-cercle::after {
            content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--accent);
            transform: scale(0); transition: transform .1s;
        }
        .mot-radio:checked ~ .mot-cercle::after { transform: scale(1); }
        .mot-radio {
            position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden;
            clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; padding: 0;
        }
        .trou-champ {
            display: inline-block; width: 160px; padding: 6px 10px; margin: 0 2px; border-radius: 8px;
            border: 1.5px solid var(--accent); font-family: inherit; font-size: 16.5px;
            text-align: center; background: var(--accent-soft); color: var(--ink);
        }
    </style>

    <div style="display:flex; flex-direction:column; gap:20px;">
        <div>
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="var(--accent)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;">
                <path d="M4 20h16"></path>
                <path d="M6 20V10l6-6 6 6v10"></path>
                <path d="M10 20v-6h4v6"></path>
            </svg>
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft);">
                {{ exercice.regle }}
            </div>
            <h1 style="font-size:22px; margin:6px 0 0;">
                {% if exercice.type.value == 'texte_a_trous' %}
                    Complète la phrase
                {% elseif exercice.type.value == 'correction' %}
                    Corrige la phrase
                {% else %}
                    Choisis le bon mot
                {% endif %}
            </h1>
        </div>

        {% set contenu = exercice.contenu %}

        <form method="post" action="{{ path('enfant_orthographe_repondre', {id: exercice.id}) }}"
              data-formulaire-orthographe style="display:flex; flex-direction:column; gap:18px;">
            {% if exercice.type.value == 'texte_a_trous' %}
                <div class="card">
                    <p style="font-size:17px; line-height:1.9; margin:0;">
                        {{ contenu.avant }}<input type="text" name="reponse" class="trou-champ" autocomplete="off" data-champ-reponse>{{ contenu.apres }}
                    </p>
                </div>
            {% elseif exercice.type.value == 'correction' %}
                <div class="card" style="border-color:var(--amber); background:oklch(95% 0.03 75);">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-soft); margin-bottom:8px;">
                        Phrase à corriger
                    </div>
                    <p style="font-size:16.5px; margin:0;">{{ contenu.phrase_incorrecte }}</p>
                </div>
                <div style="display:flex; flex-direction:column; gap:8px;">
                    <label for="reponse" style="font-weight:700;">Récris la phrase, bien orthographiée&nbsp;:</label>
                    <textarea id="reponse" name="reponse" rows="3" placeholder="Écris la phrase corrigée…" data-champ-reponse
                              style="padding:14px; border-radius:12px; border:1.5px solid var(--border); font-family:inherit; font-size:15px; line-height:1.5; resize:vertical;"></textarea>
                </div>
            {% else %}
                <div class="card">
                    <p style="font-size:17px; line-height:1.7; margin:0;">{{ contenu.avant }}<strong style="color:var(--accent);">…</strong>{{ contenu.apres }}</p>
                </div>
                {% for proposition in contenu.propositions %}
                    <label class="mot-choix" style="position:relative;">
                        <input type="radio" name="reponse" value="{{ proposition }}" class="mot-radio" data-champ-reponse>
                        <span class="mot-cercle" aria-hidden="true"></span>
                        <span style="font-size:15px;">{{ proposition }}</span>
                    </label>
                {% endfor %}
            {% endif %}

            <button type="submit" class="btn" data-bouton-valider>Valider</button>
        </form>
    </div>

    <script>
        (function () {
            const formulaire = document.querySelector('[data-formulaire-orthographe]');
            if (!formulaire) {
                return;
            }

            const bouton = formulaire.querySelector('[data-bouton-valider]');
            const champs = Array.from(formulaire.querySelectorAll('[data-champ-reponse]'));

            function estRempli() {
                return champs.some(function (champ) {
                    return champ.type === 'radio' ? champ.checked : champ.value.trim() !== '';
                });
            }

            function rafraichir() {
                bouton.disabled = !estRempli();
            }

            formulaire.addEventListener('input', rafraichir);
            formulaire.addEventListener('change', rafraichir);

            // Un double-clic enverrait deux fois le formulaire — le contrôleur s'en
            // protège aussi (un seul essai par exercice), mais autant rassurer l'enfant.
            formulaire.addEventListener('submit', function () {
                bouton.disabled = true;
                bouton.textContent = 'Un instant…';
            });

            rafraichir();
        })();
    </script>
{% endblock %}
