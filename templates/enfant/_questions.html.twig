{#
    Bloc de questions partagé par l'écran de diagnostic (§2.1) et l'écran d'exercice (§2.2).

    Paramètres attendus : `libelleBouton` (texte du bouton), `numeroter` (bool).
    Cas limite §2.2 : tant qu'une réponse manque, la validation est désactivée avec un
    message doux — jamais une erreur bloquante.
#}
<style>
    /* Options QCM stylisées (cf. maquette Diagnostic/Exercice, 01-parcours-produit-maquettes) :
       cercle personnalisé qui se remplit, bordure et fond accentués quand sélectionnée. */
    .qcm-option {
        display: flex; align-items: center; gap: 12px; padding: 13px 16px;
        border: 1.5px solid var(--border); border-radius: 12px; background: var(--surface);
        cursor: pointer; transition: border-color .12s, background-color .12s, padding .12s;
    }
    .qcm-option:has(.qcm-radio:checked) {
        border: 2px solid var(--accent); background: var(--accent-soft); padding: 12px 15px;
    }
    .qcm-cercle {
        width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--border);
        flex: none; display: flex; align-items: center; justify-content: center;
    }
    .qcm-radio:checked ~ .qcm-cercle { border-color: var(--accent); }
    .qcm-cercle::after {
        content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--accent);
        transform: scale(0); transition: transform .1s;
    }
    .qcm-radio:checked ~ .qcm-cercle::after { transform: scale(1); }
    .qcm-radio {
        position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden;
        clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; padding: 0;
    }
</style>
<form method="post" action="{{ path('enfant_exercice_repondre', {id: session.id}) }}"
      data-formulaire-reponses style="display:flex; flex-direction:column; gap:18px;">
    {% for question in texte.questions %}
        <div style="display:flex; flex-direction:column; gap:10px;">
            <label for="reponse_{{ question.id }}" style="font-weight:700;">
                {%- if numeroter|default(false) %}{{ loop.index }}. {% endif -%}
                {{ question.enonce }}
            </label>

            {% if question.type.value == 'qcm' %}
                {% for choixItem in question.choix %}
                    <label class="qcm-option" style="position:relative;">
                        <input type="radio" name="reponse_{{ question.id }}" value="{{ choixItem }}"
                               class="qcm-radio"
                               {% if loop.first %}id="reponse_{{ question.id }}"{% endif %} data-champ-reponse>
                        <span class="qcm-cercle" aria-hidden="true"></span>
                        <span style="font-size:14.5px;">{{ choixItem }}</span>
                    </label>
                {% endfor %}
            {% else %}
                <textarea id="reponse_{{ question.id }}" name="reponse_{{ question.id }}" rows="4"
                          placeholder="Écris ta réponse avec tes mots…" data-champ-reponse
                          style="padding:14px; border-radius:12px; border:1.5px solid var(--border); font-family:inherit; font-size:15px; line-height:1.5; resize:vertical;"></textarea>
            {% endif %}
        </div>
    {% endfor %}

    <div data-message-doux hidden
         style="background: var(--accent-soft); border-radius:10px; padding:12px 16px; font-size:14px;">
        Il reste une question sans réponse — prends ton temps, il n'y a pas de mauvaise réponse&nbsp;!
    </div>

    {# Actif par défaut : si le JS ne s'exécute pas, le formulaire reste utilisable
       (le contrôle de complétude est un confort, pas une garantie métier — le
       contrôleur accepte de toute façon une réponse vide et la note comme telle). #}
    <button type="submit" class="btn" data-bouton-valider>{{ libelleBouton }}</button>
</form>

<script>
    (function () {
        const formulaire = document.querySelector('[data-formulaire-reponses]');
        if (!formulaire) {
            return;
        }

        const bouton = formulaire.querySelector('[data-bouton-valider]');
        const message = formulaire.querySelector('[data-message-doux]');
        const champs = Array.from(formulaire.querySelectorAll('[data-champ-reponse]'));
        const noms = Array.from(new Set(champs.map(function (champ) { return champ.name; })));
        let aCommence = false;

        function estRepondue(nom) {
            return Array.from(formulaire.querySelectorAll('[name="' + nom + '"]')).some(function (champ) {
                return champ.type === 'radio' ? champ.checked : champ.value.trim() !== '';
            });
        }

        function rafraichir() {
            const complet = noms.every(estRepondue);
            bouton.disabled = !complet;
            // Le message n'apparaît qu'une fois l'enfant entré dans l'exercice : rien
            // ne doit ressembler à un reproche avant même qu'il ait commencé.
            message.hidden = complet || !aCommence;
        }

        formulaire.addEventListener('input', function () { aCommence = true; rafraichir(); });
        formulaire.addEventListener('change', function () { aCommence = true; rafraichir(); });

        // Un double-clic enverrait deux fois le formulaire — et la seconde soumission
        // tenterait d'enregistrer une réponse déjà existante. Le contrôleur s'en protège
        // aussi, mais autant éviter l'aller-retour inutile et rassurer l'enfant.
        formulaire.addEventListener('submit', function () {
            bouton.disabled = true;
            bouton.textContent = 'Un instant…';
        });

        rafraichir();
    })();
</script>
