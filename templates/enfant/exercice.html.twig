{% extends 'base.html.twig' %}

{% block title %}Exercice du jour — Carnet CE2{% endblock %}

{% block body %}
    <div style="display:flex; flex-direction:column; gap:20px;">
        <div style="font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft);">
            Exercice du jour — Niveau {{ session.niveauVise }}
        </div>

        <div class="card">
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--accent); margin-bottom:10px;">
                {{ texte.titre }}
            </div>
            <p style="font-size:16.5px; line-height:1.7;">{{ texte.contenu }}</p>
        </div>

        {% include 'enfant/_questions.html.twig' with {libelleBouton: 'Valider mes réponses', numeroter: true} %}
    </div>
{% endblock %}
