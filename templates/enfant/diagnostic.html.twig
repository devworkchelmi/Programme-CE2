{% extends 'base.html.twig' %}

{% block title %}Diagnostic — Carnet CE2{% endblock %}

{% block body %}
    <div style="display:flex; flex-direction:column; gap:20px;">
        <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft);">
                Diagnostic initial
            </div>
            <h1 style="font-size:24px; margin: 6px 0 0;">Petit diagnostic de lecture</h1>
            <p style="color:var(--ink-soft);">
                Lis le texte ci-dessous, puis réponds aux questions. Il n'y a pas de mauvaise réponse&nbsp;:
                on découvre juste où tu en es&nbsp;!
            </p>
        </div>

        {% if total is defined and total > 0 %}
            <div>
                <div style="display:flex; justify-content:space-between; font-size:12px; color:var(--ink-soft); margin-bottom:6px;">
                    <span>Texte {{ position }} sur {{ total }}</span>
                </div>
                <div style="background: var(--border); border-radius:99px; height:8px; overflow:hidden;">
                    <div style="background: var(--accent); height:100%; width: {{ (position / total * 100)|round }}%;"></div>
                </div>
            </div>
        {% endif %}

        <div class="card">
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--accent); margin-bottom:10px;">
                {{ texte.titre }}
            </div>
            <p style="font-size:17px; line-height:1.7;">{{ texte.contenu }}</p>
        </div>

        {% include 'enfant/_questions.html.twig' with {libelleBouton: 'Continuer', numeroter: false} %}
    </div>
{% endblock %}
