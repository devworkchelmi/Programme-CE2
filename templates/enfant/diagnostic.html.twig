{% extends 'base.html.twig' %}

{% block title %}Diagnostic — Carnet CE2{% endblock %}

{% block body %}
    <div style="display:flex; flex-direction:column; gap:20px;">
        <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft);">
                Diagnostic initial
            </div>
            <h1 style="font-size:24px; margin: 6px 0 0;">Petit diagnostic de lecture</h1>
            <p style="color:var(--ink-soft);">
                Lis le texte ci-dessous, puis réponds aux questions. Il n'y a pas de mauvaise réponse&nbsp;:
                on découvre juste où tu en es&nbsp;!
            </p>
        </div>

        <div class="card">
            <div style="font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--accent); margin-bottom:10px;">
                {{ texte.titre }}
            </div>
            <p style="font-size:17px; line-height:1.7;">{{ texte.contenu }}</p>
        </div>

        <form method="post" action="{{ path('enfant_exercice_repondre', {id: session.id}) }}" style="display:flex; flex-direction:column; gap:18px;">
            {% for question in texte.questions %}
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div style="font-weight:700;">{{ question.enonce }}</div>

                    {% if question.type.value == 'qcm' %}
                        {% for choixItem in question.choix %}
                            <label class="card" style="display:flex; align-items:center; gap:12px; cursor:pointer;">
                                <input type="radio" name="reponse_{{ question.id }}" value="{{ choixItem }}">
                                {{ choixItem }}
                            </label>
                        {% endfor %}
                    {% else %}
                        <textarea name="reponse_{{ question.id }}" rows="3" placeholder="Avec tes mots…"
                                  style="padding:14px; border-radius:12px; border:1.5px solid var(--border); font-family:inherit; font-size:15px;"></textarea>
                    {% endif %}
                </div>
            {% endfor %}

            <button type="submit" class="btn">Continuer</button>
        </form>
    </div>
{% endblock %}
